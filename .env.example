APP_NAME="Marketing Bidding Central"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
DB_CONNECTION=sqlite
# SQLite uses database/database.sqlite by default.
# For MySQL: set DB_CONNECTION=mysql plus DB_HOST, DB_PORT,
# DB_DATABASE, DB_USERNAME and DB_PASSWORD for your own database.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Marketing Bidding Central"
# Configure your SMTP server before allowing paid submissions:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SCHEME=smtp
MARKETPLACE_ADMIN_EMAIL=
MARKETPLACE_ADMIN_PASSWORD_HASH=
MARKETPLACE_OPEN=false
MARKETPLACE_LEGAL_READY=false
MARKETPLACE_MINIMUM_BID_CENTS=500
MARKETPLACE_MINIMUM_TOP_UP_CENTS=100
MARKETPLACE_OWNER_TOKEN_HOURS=8760
MARKETPLACE_LEGAL_UPDATED_AT=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
